# Server Port
PORT=3001
NODE_ENV=development

# Database Configuration (for local server running outside Docker container connecting to exposed port 5433)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USERNAME=learn_hub_user
DATABASE_PASSWORD=secret
DATABASE_NAME=learn_hub_db

# Also define DB_ prefix for compatibility with typeorm.config.ts (CLI / migrations)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=learn_hub_user
DB_PASSWORD=secret
DB_NAME=learn_hub_db
